# Built binaries and the packaged installer. dist/ is deliberately not in the
# repository: a 15MB .pkg has no business in git history, so a built installer
# becomes downloadable by being attached to a GitHub release instead.
/deadlocker
/bin/
/dist/
*.test

# Local runtime state: the bbolt store holds configuration, including an API
# key if one is set.
/.deadlocker/

# Machine-local editor/tool settings
.claude/settings.local.json

.DS_Store
